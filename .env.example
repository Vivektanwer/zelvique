# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file (it is already in .gitignore).
# These values are only read by the server. They never reach the website code in the browser.
# Step-by-step help: see SETUP-BACKEND.md

# ---- Server ----
PORT=3000
# Timezone used for the "Date" and "Time" of each lead. Full list: search "list of tz database time zones".
TIMEZONE=Asia/Kolkata

# ---- Google Apps Script (Sheet + both emails, all in one) ----
# The "Web app" URL you get after deploying Code.gs. Looks like:
#   https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_SCRIPT_URL=

# A secret password that only your server and your Apps Script know.
# Must be EXACTLY the same text as SHARED_SECRET inside Code.gs.
APPS_SCRIPT_SECRET=nYNTnWhtc5oyxA3swAIFkVdJCRwS3uNu
